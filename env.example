# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/transactionhub?schema=public"

# Auth – choose one
# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# or Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage (optional – for document files)
# S3 / Supabase Storage / local
STORAGE_BUCKET=
STORAGE_ENDPOINT=

# E-sign integration (Documenso / DocuSeal)
DOCUMENSO_API_URL=
DOCUMENSO_API_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="TransactionHub <noreply@yourdomain.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
