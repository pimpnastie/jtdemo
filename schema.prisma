// TransactionHub Prisma schema
// Designed for multi-party real estate transactions with full document & role support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  LISTING
  PURCHASE
}

enum TransactionStatus {
  ACTIVE
  UNDER_CONTRACT
  PENDING
  CLOSED
  CANCELLED
}

enum PartyRole {
  LISTING_AGENT
  BUYER
  SELLER
  TITLE_AGENT
  LENDER
  COOPERATING_AGENT
  TRANSACTION_COORDINATOR
}

enum DocumentStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  RECEIVED
  REJECTED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties   Party[]
  uploadedDocuments Document[] @relation("UploadedBy")
  messages  Message[]
  taskAssignees TaskAssignee[]
}

model Transaction {
  id          String            @id @default(cuid())
  title       String            // e.g. "123 Main St – Listing"
  address     String
  city        String?
  state       String?
  zip         String?
  type        TransactionType
  status      TransactionStatus @default(ACTIVE)
  price       Decimal?          @db.Decimal(12, 2)
  effectiveDate DateTime?       // contract effective / listing start
  closingDate DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  parties     Party[]
  documents   Document[]
  tasks       Task[]
  messages    Message[]
  checklistItems ChecklistItem[]
}

model Party {
  id            String    @id @default(cuid())
  transactionId String
  userId        String?
  role          PartyRole
  name          String    // display name even if no user yet
  email         String?
  phone         String?
  company       String?   // brokerage, title company, lender
  invitedAt     DateTime?
  joinedAt      DateTime?
  createdAt     DateTime  @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id])

  @@unique([transactionId, role, email])
  @@index([transactionId])
}

model Document {
  id            String         @id @default(cuid())
  transactionId String
  name          String
  category      String         // e.g. "Disclosure", "Contract", "Title", "Loan"
  status        DocumentStatus @default(DRAFT)
  fileUrl       String?        // storage path or external URL
  mimeType      String?
  sizeBytes     Int?
  version       Int            @default(1)
  checklistKey  String?        // links to ChecklistItem.key
  uploadedById  String?
  notes         String?
  signedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  uploadedBy    User?          @relation("UploadedBy", fields: [uploadedById], references: [id])

  @@index([transactionId])
  @@index([checklistKey])
}

model ChecklistItem {
  id            String   @id @default(cuid())
  transactionId String
  key           String   // stable key e.g. "seller_disclosure"
  label         String
  category      String
  required      Boolean  @default(true)
  completed     Boolean  @default(false)
  completedAt   DateTime?
  dueDate       DateTime?
  notes         String?
  sortOrder     Int      @default(0)

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, key])
  @@index([transactionId])
}

model Task {
  id            String     @id @default(cuid())
  transactionId String
  title         String
  description   String?
  status        TaskStatus @default(TODO)
  dueDate       DateTime?
  priority      Int        @default(0) // 0=normal, 1=high, 2=urgent
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  assignees     TaskAssignee[]

  @@index([transactionId])
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  userId String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model Message {
  id            String   @id @default(cuid())
  transactionId String
  userId        String
  body          String
  createdAt     DateTime @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@index([transactionId])
}
